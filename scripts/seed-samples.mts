/**
 * Seed the demo sample stores. `npx tsx scripts/seed-samples.mts`
 *
 * These exist as a safety net: if Apify, Deepgram or Friendli are down
 * during a demo, the start page still has three real storefronts that
 * render from our own database with no third-party call.
 *
 * They are generated by the REAL pipeline, not hand-written, so they are
 * honest examples of what the product produces. Re-running replaces them.
 */
import { readFileSync } from 'node:fs';
import { createHash, randomBytes } from 'node:crypto';

for (const line of readFileSync('.env.local', 'utf8').split('\n')) {
  const m = line.match(/^([A-Z_]+)=(.*)$/);
  if (m && !process.env[m[1]]) process.env[m[1]] = m[2].trim();
}

const { runPipeline } = await import('../lib/pipeline.js');
const { createClient } = await import('@supabase/supabase-js');

const db = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!,
);

const SAMPLES = [
  {
    slug: 'sample-baker',
    description:
      'I teach eggless baking to home cooks across small towns in India. Most of '
      + 'them have no oven at all, so everything I make works in a pressure cooker '
      + 'or a kadai. People constantly ask me why their cake sinks in the middle, '
      + 'and how to measure flour and sugar without a weighing scale.',
    name: 'Priya (sample)',
  },
  {
    slug: 'sample-tutor',
    description:
      'I take JEE Advanced physics doubts for droppers. Most of my students have '
      + 'already failed once and are terrified of rotational mechanics and modern '
      + 'physics. They ask me how to stop losing marks on silly calculation errors '
      + 'and how to revise an entire chapter the night before a mock test.',
    name: 'Arjun (sample)',
  },
  {
    slug: 'sample-tailor',
    description:
      'I teach blouse stitching and saree draping to women who want to earn from '
      + 'home. I cover measurement without a dress form, princess cut darts, and '
      + 'how to price your work so you are not undercharging. People ask me how to '
      + 'get the fit right on the first try and how to find their first customers.',
    name: 'Lakshmi (sample)',
  },
];

for (const s of SAMPLES) {
  process.stdout.write(`\nbuilding ${s.slug}... `);
  const t0 = Date.now();
  const result = await runPipeline({ description: s.description, name: s.name }, () => {});
  if (!result.ok) {
    console.log(`SKIPPED — pipeline stopped: ${result.reason}`);
    continue;
  }
  console.log(`${((Date.now() - t0) / 1000).toFixed(1)}s, ${result.products.length} products`);

  // Replace any previous version of this sample.
  await db.from('stores').delete().eq('slug', s.slug);

  const token = randomBytes(16).toString('base64url');
  const { data, error } = await db.from('stores').insert({
    slug: s.slug,
    edit_token_hash: createHash('sha256').update(token).digest('hex'),
    input_type: 'description',
    description_text: s.description,
    name: s.name,
    bio: result.bio,
    niche: result.niche,
    language: result.language,
    status: 'published',
    validation_result: result.validation,
    is_sample: true,
  }).select('id').single();
  if (error) { console.log(`  insert failed: ${error.message}`); continue; }

  const { error: pErr } = await db.from('products').insert(
    result.products.map((p) => ({
      store_id: data.id, position: p.position, ladder_role: p.ladderRole,
      format: p.format, title: p.title, promise: p.promise,
      description: p.description, points: p.points, price: p.price,
      suggested_price: p.suggestedPrice, price_reason: p.priceReason,
      scope: p.scope, effort: p.effort, demand_item: p.demandItem,
      evidence: p.evidence,
    })),
  );
  if (pErr) { console.log(`  products failed: ${pErr.message}`); continue; }

  for (const p of result.products) {
    console.log(`  [${p.ladderRole}/${p.format}] Rs.${p.price} ${p.title}`);
  }
  console.log(`  -> /s/${s.slug}`);
}
console.log('\ndone');

# Apify — Instagram scraping (apify/instagram-scraper)
# https://console.apify.com/settings/integrations
# Comma-separated Apify keys. Rotated automatically before each one
# hits the Free plan's $5/month cap. A single key still works.
APIFY_TOKENS=
APIFY_TOKEN=

# Deepgram — reel transcription (nova-3, language=multi)
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# Friendli AI — GLM 5.3 generation
# https://suite.friendli.ai  (serverless endpoints)
FRIENDLI_TOKEN=
FRIENDLI_BASE_URL=https://api.friendli.ai/serverless/v1
FRIENDLI_MODEL=zai-org/GLM-5.3

# Supabase — storage for stores, jobs, posts, products, events
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for share links and OG images
NEXT_PUBLIC_BASE_URL=http://localhost:3000
